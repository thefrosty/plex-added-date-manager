# Address the container can reach.
# Plex running on this machine:
PLEX_BASE_URL=http://host.docker.internal:32400
# Plex running on another machine:
# PLEX_BASE_URL=http://192.168.1.20:32400
# Plex that requires HTTPS. The certificate matches a plex.direct name, not the raw IP:
# PLEX_BASE_URL=https://192-168-1-20.<cert-id>.plex.direct:32400
PLEX_TOKEN=your_plex_token_here

# Library section ids from /library/sections. Defaults are 1 and 2.
PLEX_MOVIE_SECTION_ID=1
PLEX_TV_SECTION_ID=2
